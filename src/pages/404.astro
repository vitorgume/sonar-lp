---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Página não encontrada | Sonar"
  description="A página que você procurou não existe. Conheça o Sonar, a análise de ligações de vendas com IA."
  noindex
>
  <Header variant="page" />
  <main class="page">
    <div class="wrap">
      <p class="label"><span class="dot"></span>Erro 404</p>
      <h1>Essa página saiu do radar</h1>
      <p class="lead">O endereço pode ter mudado ou não existir mais.</p>
      <a class="btn btn-primary" href="/">Conhecer o Sonar</a>
    </div>
  </main>
  <Footer variant="page" />
</BaseLayout>
