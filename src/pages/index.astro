---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileCtaBar from '../components/MobileCtaBar.astro';
import LeadModal from '../components/LeadModal.astro';
import Hero from '../components/sections/Hero.astro';
import Proof from '../components/sections/Proof.astro';
import PainAnatomy from '../components/sections/PainAnatomy.astro';
import Scene from '../components/sections/Scene.astro';
import BlindSpotQuiz from '../components/sections/BlindSpotQuiz.astro';
import Offer from '../components/sections/Offer.astro';
import Why from '../components/sections/Why.astro';
import Faq from '../components/sections/Faq.astro';
import FinalCta from '../components/sections/FinalCta.astro';
import { site } from '../data/site';
import { buildHomeStructuredData } from '../data/structured-data';

const structuredData = buildHomeStructuredData(Astro.site ?? new URL(Astro.url.origin));
---

<BaseLayout title={site.title} description={site.description} path="/" structuredData={structuredData}>
  <a href="#inicio" class="skip">Pular para o conteúdo</a>
  <Header />
  <main id="inicio">
    <Hero />
    <Proof />
    <PainAnatomy />
    <Scene />
    <BlindSpotQuiz />
    <Offer />
    <Why />
    <Faq />
    <FinalCta />
  </main>
  <Footer />
  <MobileCtaBar />
  <LeadModal />
</BaseLayout>
