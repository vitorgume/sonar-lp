---
interface Props {
  /** Conteúdo do SVG (paths, circles) desenhado num viewBox 0 0 24 24. */
  paths: string;
  strokeWidth?: number;
  class?: string;
}

const { paths, strokeWidth = 2, class: className } = Astro.props;
---

<svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={strokeWidth} aria-hidden="true" set:html={paths} />
