---
import { Image } from 'astro:assets';
import Logo from './Logo.astro';
import gumeLogo from '../assets/brand/gume.png';
import { site } from '../data/site';

interface Props {
  variant?: 'home' | 'page';
}

const { variant = 'home' } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="foot">
  <div class="wrap">
    <div class="foot-sign">
      <Logo href={variant === 'home' ? '#inicio' : '/'} label="Sonar" />
      <span class="by">by</span>
      <Image src={gumeLogo} alt="Gume Inteligência Comercial" width={93} height={30} densities={[1, 2]} />
    </div>
    <span><a href="/politica-de-privacidade">Política de Privacidade</a> · © {year} {site.legalName}</span>
  </div>
</footer>
