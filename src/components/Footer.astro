---
import Logo from './Logo.astro';
import { site } from '../data/site';

interface Props {
  variant?: 'home' | 'page';
}

const { variant = 'home' } = Astro.props;
const formHref = variant === 'home' ? '#formulario' : '/#formulario';
const year = new Date().getFullYear();
---

<footer class="border-t border-slate-800 bg-slate-950">
  <div class="mx-auto flex max-w-7xl flex-col gap-8 px-4 py-10 sm:px-6 md:flex-row md:items-center md:justify-between lg:px-8">
    <div>
      <Logo variant="dark" showTagline />
      <p class="mt-4 max-w-sm text-sm text-slate-400">
        Inteligência artificial que avalia as ligações do seu time comercial com a régua do seu playbook.
      </p>
    </div>

    <nav aria-label="Links institucionais">
      <ul class="flex flex-wrap gap-x-6 gap-y-3 text-sm">
        <li><a href={formHref} class="font-medium text-slate-300 hover:text-white" data-cta="rodape">Agendar demonstração</a></li>
        <li>
          <a href={site.whatsappUrl} target="_blank" rel="noopener" class="font-medium text-slate-300 hover:text-white">WhatsApp comercial</a>
        </li>
        <li><a href="/politica-de-privacidade" class="font-medium text-slate-300 hover:text-white">Política de Privacidade</a></li>
      </ul>
    </nav>
  </div>
  <div class="border-t border-slate-800">
    <p class="mx-auto max-w-7xl px-4 pt-6 pb-24 text-xs text-slate-500 sm:px-6 lg:px-8 lg:pb-6">
      © {year} {site.legalName}. Todos os direitos reservados.
    </p>
  </div>
</footer>
