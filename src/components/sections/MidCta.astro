---
import ArrowRight from '@lucide/astro/icons/arrow-right';
import { midCta } from '../../data/content';
---

<section aria-labelledby="cta-meio-titulo" class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
  <div class="relative overflow-hidden rounded-xl bg-teal-600 px-6 py-12 shadow-sm sm:px-12 lg:flex lg:items-center lg:justify-between lg:gap-10">
    <svg class="pointer-events-none absolute -right-20 -bottom-24 h-80 w-80 text-white/10" viewBox="0 0 132 132" fill="none" aria-hidden="true">
      <circle cx="66" cy="66" r="24" stroke="currentColor" stroke-width="6"></circle>
      <circle cx="66" cy="66" r="40" stroke="currentColor" stroke-width="6"></circle>
      <circle cx="66" cy="66" r="56" stroke="currentColor" stroke-width="6"></circle>
    </svg>
    <div class="relative max-w-2xl">
      <h2 id="cta-meio-titulo" class="text-2xl font-semibold tracking-tight text-white text-balance sm:text-3xl">{midCta.title}</h2>
      <p class="mt-3 text-teal-50 text-pretty">{midCta.description}</p>
    </div>
    <a
      href="#formulario"
      class="relative mt-8 flex items-center justify-center gap-2 rounded-lg bg-white px-6 py-3 text-base font-semibold text-teal-700 shadow-sm transition-colors hover:bg-teal-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-teal-600 lg:mt-0 lg:shrink-0"
      data-cta="meio"
    >
      {midCta.button}
      <ArrowRight class="h-4 w-4" aria-hidden="true" />
    </a>
  </div>
</section>
