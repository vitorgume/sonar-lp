---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Phone from '@lucide/astro/icons/phone';
import Plug from '@lucide/astro/icons/plug';
import api4com from '../../assets/integrations/api4com.png';
import moskit from '../../assets/integrations/moskit.png';
import pipedrive from '../../assets/integrations/pipedrive.png';
import piperun from '../../assets/integrations/piperun.png';
import symaVoiceip from '../../assets/integrations/syma-voiceip.png';
import { integrations, type Integration, type IntegrationLogo } from '../../data/content';

interface IntegrationGroup {
  label: string;
  ariaLabel: string;
  items: Integration[];
}

const logos: Record<IntegrationLogo, ImageMetadata> = {
  api4com,
  moskit,
  pipedrive,
  piperun,
  'syma-voiceip': symaVoiceip,
};

const groups: IntegrationGroup[] = [
  { label: 'CRM', ariaLabel: 'CRMs integrados', items: integrations.crm },
  { label: 'Central VoIP', ariaLabel: 'Centrais VoIP integradas', items: integrations.voip },
];
---

<section id="integracoes" aria-labelledby="integracoes-titulo" class="scroll-mt-20 border-y border-slate-200 bg-white">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <h2 id="integracoes-titulo" class="text-center text-sm font-semibold text-slate-500">
      {integrations.title}
    </h2>

    <div class="mt-8 grid gap-8 md:grid-cols-2 md:gap-0">
      {groups.map((group, index) => (
        <div class:list={['flex flex-col items-center gap-4', index > 0 && 'md:border-l md:border-slate-200']}>
          <span class="inline-flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wider text-slate-400">
            {index === 0 ? <Plug class="h-4 w-4" aria-hidden="true" /> : <Phone class="h-4 w-4" aria-hidden="true" />}
            {group.label}
          </span>
          <ul class="grid w-full max-w-md grid-cols-3 gap-3" aria-label={group.ariaLabel}>
            {group.items.map((item) => (
              <li class="flex flex-col items-center gap-2 rounded-xl border border-slate-200 bg-slate-50 px-3 py-4 text-center">
                <Image
                  src={logos[item.logo]}
                  alt={item.vendor ? `Logo da ${item.vendor}, dona do ${item.name}` : `Logo do ${item.name}`}
                  width={48}
                  height={48}
                  densities={[1, 2]}
                  loading="lazy"
                  class="h-12 w-12 rounded-xl object-contain shadow-sm ring-1 ring-slate-200"
                />
                <span class="text-sm font-semibold text-slate-700">{item.name}</span>
                {item.vendor && <span class="-mt-1.5 text-[0.6875rem] leading-tight text-slate-400">por {item.vendor}</span>}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
