---
import Phone from '@lucide/astro/icons/phone';
import Plug from '@lucide/astro/icons/plug';
import { integrations } from '../../data/content';
---

<section id="integracoes" aria-labelledby="integracoes-titulo" class="scroll-mt-20 border-y border-slate-200 bg-white">
  <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
    <h2 id="integracoes-titulo" class="text-center text-sm font-semibold text-slate-500">
      {integrations.title}
    </h2>

    <div class="mt-6 grid gap-6 md:grid-cols-2">
      <div class="flex flex-col items-center gap-3 md:flex-row md:justify-end">
        <span class="inline-flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wider text-slate-400">
          <Plug class="h-4 w-4" aria-hidden="true" /> CRM
        </span>
        <ul class="flex flex-wrap justify-center gap-2" aria-label="CRMs integrados">
          {integrations.crm.map((name) => (
            <li class="rounded-lg border border-slate-200 bg-slate-50 px-4 py-2 text-sm font-semibold text-slate-700">{name}</li>
          ))}
        </ul>
      </div>

      <div class="flex flex-col items-center gap-3 md:flex-row md:justify-start md:border-l md:border-slate-200 md:pl-6">
        <span class="inline-flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wider text-slate-400">
          <Phone class="h-4 w-4" aria-hidden="true" /> Central VoIP
        </span>
        <ul class="flex flex-wrap justify-center gap-2" aria-label="Centrais VoIP integradas">
          {integrations.voip.map((name) => (
            <li class="rounded-lg border border-slate-200 bg-slate-50 px-4 py-2 text-sm font-semibold text-slate-700">{name}</li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
