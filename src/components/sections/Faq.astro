---
import { faqs } from '../../data/content';
---

<section class="s" id="duvidas" aria-labelledby="h-faq">
  <div class="wrap faq">
    <div class="s-head">
      <p class="label">Dúvidas</p>
      <h2 id="h-faq">Antes do seu Raio-X.</h2>
    </div>
    <div class="faq-list">
      {faqs.map((faq) => (
        <details>
          <summary>{faq.question}</summary>
          <p>{faq.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>
