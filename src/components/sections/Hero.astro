---
import CircleCheck from '@lucide/astro/icons/circle-check';
import LeadForm from '../LeadForm.astro';
import { hero } from '../../data/content';
import { ui } from '../../styles/ui';
---

<section id="inicio" aria-labelledby="hero-titulo" class="relative overflow-hidden">
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div class="absolute -top-40 left-1/2 h-[42rem] w-[42rem] -translate-x-1/2 rounded-full bg-teal-100/60 blur-3xl lg:left-1/4"></div>
    <div class="absolute top-20 right-0 h-80 w-80 rounded-full bg-sky-100/70 blur-3xl"></div>
    <svg class="absolute -top-24 -left-24 h-[36rem] w-[36rem] text-teal-600/10" viewBox="0 0 132 132" fill="none">
      <circle cx="66" cy="66" r="24" stroke="currentColor" stroke-width="1"></circle>
      <circle cx="66" cy="66" r="40" stroke="currentColor" stroke-width="1"></circle>
      <circle cx="66" cy="66" r="56" stroke="currentColor" stroke-width="1"></circle>
    </svg>
  </div>

  <div class="mx-auto grid max-w-7xl gap-12 px-4 pt-12 pb-16 sm:px-6 sm:pt-16 lg:grid-cols-12 lg:gap-10 lg:px-8 lg:pt-20 lg:pb-24">
    <div class="lg:col-span-6 lg:pt-6 xl:col-span-7">
      <p class={ui.aiBadge}>
        <span class="relative flex h-2 w-2" aria-hidden="true">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-sky-500 opacity-60 motion-reduce:animate-none"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-sky-600"></span>
        </span>
        {hero.eyebrow}
      </p>

      <h1 id="hero-titulo" class="mt-5 text-4xl font-semibold tracking-tight text-slate-900 text-balance sm:text-5xl xl:text-6xl">
        {hero.title} <span class="text-teal-600">{hero.titleHighlight}</span> {hero.titleEnd}
      </h1>

      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-slate-600 text-pretty">
        {hero.lead}
      </p>

      <ul class="mt-8 space-y-3">
        {hero.bullets.map((bullet) => (
          <li class="flex items-start gap-3 text-slate-700">
            <CircleCheck class="mt-0.5 h-5 w-5 shrink-0 text-emerald-500" aria-hidden="true" />
            <span class="font-medium">{bullet}</span>
          </li>
        ))}
      </ul>

      <div class="mt-10 hidden flex-wrap items-center gap-3 lg:flex">
        <a href="#como-funciona" class={ui.buttonSecondaryLg}>Ver como funciona</a>
      </div>
    </div>

    <div id="formulario" class="scroll-mt-24 lg:col-span-6 xl:col-span-5" data-hero-form>
      <LeadForm idPrefix="hero" />
    </div>
  </div>
</section>
