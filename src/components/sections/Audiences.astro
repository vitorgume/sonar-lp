---
import Icon from '../ui/Icon.astro';
import { audiences } from '../../data/content';
import { ui } from '../../styles/ui';
---

<section aria-labelledby="publico-titulo" class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8 lg:py-28">
  <div class="mx-auto max-w-3xl text-center">
    <p class={ui.eyebrow}>{audiences.eyebrow}</p>
    <h2 id="publico-titulo" class:list={[ui.sectionTitle, 'mt-3']}>{audiences.title}</h2>
  </div>

  <ul class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
    {audiences.items.map((audience) => (
      <li class={ui.card}>
        <span class="inline-flex h-11 w-11 items-center justify-center rounded-lg bg-teal-50 text-teal-700">
          <Icon name={audience.icon} />
        </span>
        <h3 class="mt-5 text-base font-semibold text-slate-900">{audience.title}</h3>
        <p class="mt-2 text-sm leading-relaxed text-slate-500">{audience.description}</p>
      </li>
    ))}
  </ul>
</section>
