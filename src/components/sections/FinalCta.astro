---
import CircleCheck from '@lucide/astro/icons/circle-check';
import MessageCircle from '@lucide/astro/icons/message-circle';
import LeadForm from '../LeadForm.astro';
import { finalCta } from '../../data/content';
import { site } from '../../data/site';
---

<section aria-labelledby="cta-final-titulo" class="relative overflow-hidden bg-slate-900">
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div class="absolute -top-32 -left-32 h-[32rem] w-[32rem] rounded-full bg-teal-500/15 blur-3xl"></div>
  </div>

  <div class="relative mx-auto grid max-w-7xl gap-12 px-4 py-20 sm:px-6 lg:grid-cols-12 lg:items-center lg:px-8 lg:py-28">
    <div class="lg:col-span-6 xl:col-span-7">
      <p class="text-sm font-semibold uppercase tracking-wider text-teal-400">{finalCta.eyebrow}</p>
      <h2 id="cta-final-titulo" class="mt-3 text-3xl font-semibold tracking-tight text-white text-balance sm:text-4xl">
        {finalCta.title}
      </h2>
      <p class="mt-4 max-w-xl text-lg text-slate-400 text-pretty">{finalCta.lead}</p>

      <ul class="mt-8 space-y-3">
        {finalCta.bullets.map((bullet) => (
          <li class="flex items-start gap-3 text-slate-200">
            <CircleCheck class="mt-0.5 h-5 w-5 shrink-0 text-teal-400" aria-hidden="true" />
            <span>{bullet}</span>
          </li>
        ))}
      </ul>

      <p class="mt-10 text-sm text-slate-400">
        Prefere conversar agora?
        <a
          href={site.whatsappUrl}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-1.5 font-semibold text-teal-300 underline-offset-4 hover:text-teal-200 hover:underline"
          data-cta="whatsapp-final"
        >
          <MessageCircle class="h-4 w-4" aria-hidden="true" /> Fale com o time pelo WhatsApp
        </a>
      </p>
    </div>

    <div class="lg:col-span-6 xl:col-span-5">
      <LeadForm idPrefix="final" headingLevel="h3" />
    </div>
  </div>
</section>
