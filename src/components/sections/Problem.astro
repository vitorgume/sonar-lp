---
import Icon from '../ui/Icon.astro';
import { problem } from '../../data/content';
import { ui } from '../../styles/ui';
---

<section aria-labelledby="problema-titulo" class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8 lg:py-28">
  <div class="mx-auto max-w-3xl text-center">
    <p class={ui.eyebrow}>{problem.eyebrow}</p>
    <h2 id="problema-titulo" class:list={[ui.sectionTitle, 'mt-3']}>{problem.title}</h2>
    <p class={ui.sectionLead}>{problem.lead}</p>
  </div>

  <ul class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
    {problem.items.map((item) => (
      <li class={ui.card}>
        <span class="inline-flex h-11 w-11 items-center justify-center rounded-lg bg-rose-50 text-rose-700">
          <Icon name={item.icon} />
        </span>
        <h3 class="mt-5 text-base font-semibold text-slate-900">{item.title}</h3>
        <p class="mt-2 text-sm leading-relaxed text-slate-500">{item.description}</p>
      </li>
    ))}
  </ul>
</section>
