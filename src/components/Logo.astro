---
interface Props {
  href: string;
  label?: string;
  showTagline?: boolean;
}

const { href, label = 'Sonar, início', showTagline = false } = Astro.props;
---

<a class="brand" href={href} aria-label={label}>
  <svg aria-hidden="true"><use href="#sonar-mark"></use></svg>
  {showTagline ? (
    <span><b>Sonar</b><small>SALES CALL INTELLIGENCE</small></span>
  ) : (
    <b>Sonar</b>
  )}
</a>
