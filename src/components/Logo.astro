---
interface Props {
  variant?: 'light' | 'dark';
  showTagline?: boolean;
  class?: string;
}

const { variant = 'light', showTagline = false, class: className = '' } = Astro.props;

const markColor = variant === 'dark' ? '#2DD4BF' : '#0D9488';
const wordClass = variant === 'dark' ? 'text-slate-50' : 'text-slate-900';
const taglineClass = variant === 'dark' ? 'text-slate-400' : 'text-slate-500';
---

<span class:list={['inline-flex items-center gap-2.5', className]}>
  <svg class="h-8 w-8 shrink-0" viewBox="0 0 132 132" fill="none" aria-hidden="true">
    <circle cx="66" cy="66" r="11" fill={markColor}></circle>
    <circle cx="66" cy="66" r="30" stroke={markColor} stroke-width="11" stroke-linecap="round" stroke-dasharray="118 250" transform="rotate(-45 66 66)"></circle>
    <circle cx="66" cy="66" r="54" stroke={markColor} stroke-width="11" stroke-linecap="round" stroke-dasharray="212 400" transform="rotate(-45 66 66)" opacity=".45"></circle>
  </svg>
  <span class="flex flex-col leading-none">
    <span class:list={['text-xl font-bold tracking-tight', wordClass]}>Sonar</span>
    {showTagline && (
      <span class:list={['mt-1 text-[0.625rem] font-semibold uppercase tracking-[0.18em]', taglineClass]}>
        Sales Call Intelligence
      </span>
    )}
  </span>
</span>
