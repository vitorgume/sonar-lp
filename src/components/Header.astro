---
import Logo from './Logo.astro';
import { navLinks } from '../data/site';
import { ui } from '../styles/ui';

interface Props {
  /** `home`: navegação por âncoras + CTA para o formulário. `page`: páginas internas, só logo e retorno. */
  variant?: 'home' | 'page';
}

const { variant = 'home' } = Astro.props;
const isHome = variant === 'home';
---

<header class="sticky top-0 z-40 border-b border-slate-200/80 bg-white/90 backdrop-blur supports-[backdrop-filter]:bg-white/75">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-6 px-4 sm:px-6 lg:px-8">
    <a
      href={isHome ? '#inicio' : '/'}
      class="rounded-lg focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-teal-500"
      aria-label="Sonar — página inicial"
    >
      <Logo />
    </a>

    {isHome && (
      <nav aria-label="Seções da página" class="hidden lg:block">
        <ul class="flex items-center gap-8">
          {navLinks.map((link) => (
            <li>
              <a href={link.href} class="text-sm font-medium text-slate-600 transition-colors hover:text-teal-700">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )}

    {isHome ? (
      <a href="#formulario" class:list={[ui.buttonPrimary, 'text-sm whitespace-nowrap']} data-cta="header">
        Agendar demonstração
      </a>
    ) : (
      <a href="/" class:list={[ui.buttonSecondary, 'text-sm whitespace-nowrap']}>
        Voltar ao site
      </a>
    )}
  </div>
</header>
