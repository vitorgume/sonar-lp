---
import { Image } from 'astro:assets';
import Logo from './Logo.astro';
import gumeLogo from '../assets/brand/gume.png';
import { navLinks } from '../data/site';

interface Props {
  /** `home`: navegação por âncoras + CTA do Raio-X. `page`: páginas internas, só marca e retorno. */
  variant?: 'home' | 'page';
}

const { variant = 'home' } = Astro.props;
const isHome = variant === 'home';
---

<header class="top">
  <div class="wrap">
    <div class="brandwrap">
      <Logo href={isHome ? '#inicio' : '/'} label={isHome ? 'Sonar, início' : 'Sonar, página inicial'} showTagline />
      <span class="byg">
        <span>by</span>
        <Image src={gumeLogo} alt="Gume Inteligência Comercial" width={74} height={24} densities={[1, 2]} loading="eager" />
      </span>
    </div>
    {isHome ? (
      <nav aria-label="Principal">
        {navLinks.map((link) => <a href={link.href}>{link.label}</a>)}
        <button class="btn btn-primary" type="button" data-open="demo" data-src="header">Quero meu Raio-X</button>
      </nav>
    ) : (
      <a class="btn btn-ghost" href="/">Voltar ao site</a>
    )}
  </div>
</header>
