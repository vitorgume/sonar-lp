# Domínio final da LP (usado em canonical, Open Graph e sitemap)
SITE_URL=https://sonarbiz.com.br

# Endpoint que recebe o POST JSON do formulário (webhook do CRM, n8n, Make, RD Station...)
# Precisa aceitar CORS vindo do domínio da LP.
PUBLIC_LEAD_ENDPOINT=

# Google Tag Manager (opcional). O envio do formulário dispara o evento `generate_lead` no dataLayer.
PUBLIC_GTM_ID=

# WhatsApp comercial (opcional), só dígitos com DDI. Ex.: 5511912345678
PUBLIC_WHATSAPP_NUMBER=5544991494350
