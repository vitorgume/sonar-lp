# Domínio final da LP (usado em canonical, Open Graph e sitemap). Lido no build.
SITE_URL=https://lp.sonarbiz.com.br

# Webhook do n8n que recebe os leads. Lidos em tempo de execução, só no servidor (nunca vão ao navegador).
N8N_WEBHOOK_URL=https://seu-workspace.app.n8n.cloud/webhook/<id-do-webhook>
# Valor enviado no header `atkey` para autenticar no n8n.
N8N_WEBHOOK_ATKEY=<uuid-de-autenticacao>

# Google Tag Manager (opcional). O envio do formulário dispara o evento `generate_lead` no dataLayer.
PUBLIC_GTM_ID=
